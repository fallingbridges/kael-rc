# Copy this file to .env.local and fill in your own key.
# .env.local is gitignored. Never paste a key into chat, a commit, or a doc.

OPENROUTER_API_KEY=

# The turn model writes acks and questions; it needs to be fast, because its
# latency hides inside the typing-dots beat. Sonnet is the right tier.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# The report model writes the payoff screen while the loader runs, so it can
# afford to be heavy. Leave empty to reuse the turn model.
# Recommended: anthropic/claude-opus-4.1
OPENROUTER_MODEL_REPORT=

# ── V2 Journeys ───────────────────────────────────────────────────────────
# The adaptive therapy journeys talk to Anthropic directly, no gateway.
# One key drives all three routes; effort per route is set in server/journey.js.
ANTHROPIC_API_KEY=

# Optional override. Defaults to claude-opus-5.
ANTHROPIC_MODEL=
